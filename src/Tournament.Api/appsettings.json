{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] ({CorrelationId}) {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost,7272;Database=GroupStageSim;User Id=sa;Password=P@ssw0rd1234!;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "groupsim.matches",
    "ScheduledQueueName": "groupsim.simulator.in",
    "PlayedQueueName": "groupsim.api.in",
    "ScheduledRoutingKey": "scheduled",
    "PlayedRoutingKey": "played"
  },
  "Broker": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*"
}
