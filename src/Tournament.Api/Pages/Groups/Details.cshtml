@page
@model Tournament.Api.Pages.Groups.DetailsModel

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h1 class="mb-1">@Model.GroupName</h1>
        <div class="text-muted">Group ID: <code>@Model.GroupId</code></div>
    </div>
    <div class="d-flex flex-column flex-sm-row gap-2 align-items-stretch">
        <button class="btn btn-primary" id="simulate-once" data-action="simulate" data-iterations="1">Simulate once</button>
        <div class="input-group">
            <label class="input-group-text" for="iterations-input">Iterations</label>
            <input id="iterations-input" class="form-control" type="number" min="1" max="1000" step="1" value="1" />
            <button class="btn btn-outline-primary" id="simulate-many" data-action="simulate">Run</button>
        </div>
        <button class="btn btn-outline-secondary" id="refresh" data-action="refresh">Refresh</button>
    </div>
</div>

<div id="loading-indicator" class="d-none mb-3 align-items-center gap-2">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span>Waiting for simulation results...</span>
</div>

<div id="simulation-status-panel" class="alert alert-info d-none" role="status">
    <div class="d-flex flex-column">
        <strong class="status-heading">Simulation status</strong>
        <span id="simulation-status-text" class="status-text"></span>
        <small id="simulation-status-footnote" class="status-footnote text-muted mt-1"></small>
    </div>
</div>

<section class="mb-5" id="standings-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Standings</h2>
    </div>
    <div id="standings-container">
        <partial name="_StandingsTable" model="Model.Standings" />
    </div>
</section>

<section id="matches-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Matches</h2>
    </div>
    <div id="matches-container">
        <partial name="_MatchesTable" model="new Tournament.Api.Pages.Models.MatchesTableViewModel(Model.Matches, Model.TeamNames)" />
    </div>
</section>

@section Scripts {
    <script>
        window.groupDetailsState = @Html.Raw(Model.InitialStateJson);
    </script>
    <script src="~/js/group-details.js"></script>
}
