@page
@model Tournament.Api.Pages.Groups.DetailsModel

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h1 class="mb-1">@Model.GroupName</h1>
        <div class="text-muted">Group ID: <code>@Model.GroupId</code></div>
    </div>
    <div class="d-flex gap-2 align-items-stretch">
        <button class="btn btn-primary" id="simulate-once" data-action="simulate">Simulate once</button>
        <button class="btn btn-outline-danger" id="reset" data-action="reset">Reset</button>
        <button class="btn btn-outline-secondary" id="refresh" data-action="refresh">Refresh</button>
    </div>
</div>

<div id="loading-indicator" class="d-none mb-3 align-items-center gap-2">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span>Processing...</span>
</div>

<section class="mb-5" id="standings-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Standings</h2>
    </div>
    <div id="standings-container">
        @{
            var tieBreakerCollapseId = $"tie-breaker-rules-{Model.GroupId:N}";
            ViewData["TieBreakerCollapseId"] = tieBreakerCollapseId;
        }
        <partial name="_StandingsTable" model="Model.Standings" />
        @{
            ViewData.Remove("TieBreakerCollapseId");
        }
    </div>
</section>

<section id="matches-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Matches</h2>
    </div>
    <div id="matches-container">
        <partial name="_MatchesTable" model="new Tournament.Api.Pages.Models.MatchesTableViewModel(Model.Matches, Model.TeamNames)" />
    </div>
</section>

@section Scripts {
    <script>
        window.groupDetailsState = @Html.Raw(Model.InitialStateJson);
    </script>
    <script src="~/js/group-details.js"></script>
}
