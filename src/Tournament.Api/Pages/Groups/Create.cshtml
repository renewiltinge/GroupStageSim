@page
@model Tournament.Api.Pages.Groups.CreateModel

<h1 class="mb-4">Create a Group</h1>
<p class="text-muted">Provide a group name and four teams to generate the round-robin schedule.</p>

<form method="post" class="needs-validation" novalidate>
    <div class="mb-3">
        <label asp-for="Input.Name" class="form-label">Group name</label>
        <input asp-for="Input.Name" class="form-control" required maxlength="100" />
        <span class="text-danger" asp-validation-for="Input.Name"></span>
    </div>

    <div class="row g-3">
        @for (var index = 0; index < Model.Input.Teams.Count; index++)
        {
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5">Team @(index + 1)</h2>
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label asp-for="Input.Teams[index].Name" class="form-label">Name</label>
                                <input asp-for="Input.Teams[index].Name" class="form-control" required maxlength="100" data-team-name />
                                <span class="text-danger" asp-validation-for="Input.Teams[index].Name"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.Teams[index].Strength" class="form-label">Strength</label>
                                <input asp-for="Input.Teams[index].Strength" class="form-control" type="number" min="0.1" max="3.0" step="0.1" required data-team-strength />
                                <span class="text-danger" asp-validation-for="Input.Teams[index].Strength"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 d-flex gap-3">
        <button type="submit" class="btn btn-primary">Create group</button>
        <a asp-page="/Ui/Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/create-group.js"></script>
}
