@model Tournament.Api.Pages.Models.MatchesTableViewModel

@if (Model.Matches.Count == 0)
{
    <p class="text-muted">Matches will appear once scheduling is complete.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Round</th>
                    <th scope="col">Home</th>
                    <th scope="col">Away</th>
                    <th scope="col">Score</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var match in Model.Matches.OrderBy(m => m.Round).ThenBy(m => m.ScheduledKickoff))
                {
                    Model.TeamNames.TryGetValue(match.HomeTeamId, out var homeName);
                    Model.TeamNames.TryGetValue(match.AwayTeamId, out var awayName);
                    var displayHome = string.IsNullOrWhiteSpace(homeName) ? match.HomeTeamId.ToString("N") : homeName;
                    var displayAway = string.IsNullOrWhiteSpace(awayName) ? match.AwayTeamId.ToString("N") : awayName;
                    <tr>
                        <td>@match.Round</td>
                        <td><span class="team-name" title="@displayHome">@displayHome</span></td>
                        <td><span class="team-name" title="@displayAway">@displayAway</span></td>
                        <td>
                            @if (match.HomeScore.HasValue && match.AwayScore.HasValue)
                            {
                                <span>@match.HomeScore - @match.AwayScore</span>
                            }
                            else
                            {
                                <span>&mdash;</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
