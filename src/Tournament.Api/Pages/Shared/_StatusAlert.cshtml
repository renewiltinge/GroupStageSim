@{
    var status = TempData["StatusMessage"] as string ?? ViewData["StatusMessage"] as string;
    var error = TempData["ErrorMessage"] as string ?? ViewData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @status
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="global-alert" class="alert alert-danger alert-dismissible fade" role="alert" hidden>
    <span id="global-alert-text"></span>
    <button id="global-alert-retry" type="button" class="btn btn-link btn-sm ms-2 d-none">Try again</button>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
