@page "/ui"
@model Tournament.Api.Pages.Ui.IndexModel

<section class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title">Create a Group</h2>
                <p class="card-text">Seed four teams, schedule the matches, and prepare the simulation.</p>
                <div class="mt-auto">
                    <a class="btn btn-primary" asp-page="/Groups/Create">Get started</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h2 class="card-title">Open Swagger</h2>
                <p class="card-text">Review and exercise the public REST endpoints directly.</p>
                <div class="mt-auto">
                    <a class="btn btn-outline-secondary" href="/swagger" target="_blank" rel="noopener">View API docs</a>
                </div>
            </div>
        </div>
    </div>
</section>
