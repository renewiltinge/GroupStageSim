# GroupStageSim Environment Variables Example
# Copy this file to .env and update with your actual values

# Database
SA_PASSWORD=ChangeThisStrong!

# Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Optional overrides (uncomment and modify as needed)
# CONNECTIONSTRINGS__DEFAULT=Server=localhost,7272;Database=GroupStageSim;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True
# BROKER__HOSTNAME=localhost
# BROKER__PORT=5672
# BROKER__USERNAME=guest
# BROKER__PASSWORD=guest